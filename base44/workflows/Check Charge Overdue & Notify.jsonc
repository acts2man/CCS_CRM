{
  "name": "Check Charge Overdue & Notify",
  "description": "When a charge is overdue (due_date passed and status unpaid/partial), marks StudentBalance as overdue and sends billing notification to parents.",
  "trigger": {
    "condition": "${ ((.trigger.data.due_date < \"2026-04-06\") and (.trigger.data.status == \"unpaid\" or .trigger.data.status == \"partial\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Charge"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "check_charge_overdue_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkChargeOverdue",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkChargeOverdue"
  }
}